# -----------------------------
# 基础配置
# -----------------------------
TZ=Asia/Shanghai
JWT_SECRET_KEY=CHANGE_ME_IN_DOT_ENV

# Optional prebuilt image. Leave empty to build locally.
# PING_MONITOR_IMAGE=tannic666/ping-monitor:latest

# Optional package mirrors used only during docker build.
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_EXTRA_INDEX_URL=
# PIP_TRUSTED_HOST=
# NPM_REGISTRY=https://registry.npmjs.org/

# -----------------------------
# 数据库配置
# 不填写 DATABASE_URL 时，系统自动回退到 SQLite
# -----------------------------
DATABASE_URL=mysql+pymysql://ping_monitor:CHANGE_ME_IN_DOT_ENV@mysql:3306/ping_monitor?charset=utf8mb4
# DB_PATH=./data/ping_monitor.db

# -----------------------------
# Redis 缓存配置
# 在 Docker Compose 的 mysql-redis 模式下，应用容器会自动拼接 REDIS_URL
# 如果你手动运行后端，可按需显式设置 REDIS_URL
# -----------------------------
# REDIS_URL=redis://:redis123456@redis:6379/0
ENABLE_CACHE=true
CACHE_TTL_DASHBOARD=15
CACHE_TTL_DATABOARD=45
CACHE_TTL_HOST_DETAIL=30

# Local clone safety switches. Keep false on production.
DISABLE_NOTIFICATIONS=false
DISABLE_SCHEDULER=false

# -----------------------------
# MySQL 容器配置
# 默认只绑定到宿主机 127.0.0.1，更安全
# 如果确实需要外部机器直接访问，可改成 0.0.0.0，并配防火墙白名单
# -----------------------------
MYSQL_BIND_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_IN_DOT_ENV
MYSQL_DATABASE=ping_monitor
MYSQL_USER=ping_monitor
MYSQL_PASSWORD=CHANGE_ME_IN_DOT_ENV

# -----------------------------
# Redis 容器配置
# 默认只绑定到宿主机 127.0.0.1，更安全
# 如果确实需要外部机器直接访问，可改成 0.0.0.0，并配防火墙白名单
# -----------------------------
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=CHANGE_ME_IN_DOT_ENV
